# ── Required ──────────────────────────────────────────────────────────────

# OpenAI direct — default route for every text API role.
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_API_KEY=  # optional compatibility alias for the same key

# ── Optional credentials ──────────────────────────────────────────────────

# OpenRouter — optional alternative text/image gateway.
# OPENROUTER_API_KEY=

# Stock Anthropic — only if you want to call Claude directly without
# going through OpenRouter. Not required when OPENROUTER_API_KEY is set.
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini — only required if you switch IMAGE_MODEL to a native `gemini-*`
# / `imagen-*` id (or set IMAGE_PROVIDER=gemini explicitly). The current
# default is a Google image model routed through OpenRouter, so most users
# can leave this unset.
# GEMINI_API_KEY=AIza...

# ── Model selection (optional — defaults are listed) ──────────────────────

# Defaults:
#   designer     → coding harness owns its model; internal API fallback gpt-5.5
#   critic       → gpt-5.4-nano
#   enhancer     → gpt-5.4-nano
#   claim_graph  → gpt-5.4-nano
#   deck_outline → gpt-5.4-nano
#   paper_memory → gpt-5.4-nano
#   composer     → gpt-5.4-nano
#   ingest       → gpt-5.4-nano
#
# The Web UI keeps Designer on the coding harness and never applies Pipeline
# text/vision overrides to it. Empty helper-model fields use the backend
# defaults above instead of inheriting the coding-harness model. Provider is
# auto-detected from the model id prefix:
# `anthropic/...` / `claude-...` → Anthropic; everything else → OpenAI-compatible.
#
# Switch a role to Claude (or any other model — same shape):
#   DESIGNER_MODEL=anthropic/claude-opus-4.7
#   CRITIC_MODEL=anthropic/claude-opus-4.7
#   ENHANCER_MODEL=anthropic/claude-opus-4.7
#
# Force a provider when auto-detection guesses wrong:
#   DESIGNER_PROVIDER=openai_compat   # auto | anthropic | openai_compat
#   CRITIC_PROVIDER=anthropic
#   ENHANCER_PROVIDER=auto
#   CLAIM_GRAPH_PROVIDER=auto
#   COMPOSER_PROVIDER=auto

# DESIGNER_MODEL=gpt-5.5  # optional explicit override; normally leave unset
# CRITIC_MODEL=gpt-5.4-nano
# ENHANCER_MODEL=gpt-5.4-nano
# CLAIM_GRAPH_MODEL=gpt-5.4-nano
# DECK_OUTLINE_MODEL=gpt-5.4-nano
# PAPER_MEMORY_MODEL=gpt-5.4-nano
# COMPOSER_MODEL=gpt-5.4-nano
# INGEST_MODEL=gpt-5.4-nano
# DESIGNER_PROVIDER=auto
# CRITIC_PROVIDER=auto
# ENHANCER_PROVIDER=auto
# CLAIM_GRAPH_PROVIDER=auto
# DECK_OUTLINE_PROVIDER=auto
# COMPOSER_PROVIDER=auto

# ── Extended thinking / reasoning budget ──────────────────────────────────

# Both backends honour these. budget=0 disables thinking entirely (faster
# + cheaper; useful for dev runs). Anthropic uses the thinking={} block;
# OpenAI-compat uses extra_body.reasoning.max_tokens (OpenRouter unified
# format — providers that don't support it ignore it silently).
# DESIGNER_THINKING_BUDGET=10000
# CRITIC_THINKING_BUDGET=10000
# ENHANCER_THINKING_BUDGET=10000

# Skip the v2.4 prompt enhancer stage entirely (per-run flag is `--skip-enhancer`).
# SKIP_PROMPT_ENHANCER=1

# Anthropic-only: interleaved-thinking-2025-05-14 beta header — lets
# Claude emit thinking blocks *between* tool calls instead of only at
# turn start. No-op for OpenAI-compat backends.
# ENABLE_INTERLEAVED_THINKING=1

# ── Self-hosted / alternative OpenAI-compat endpoints ─────────────────────

# Override base_url + key to point at self-hosted vLLM / SGLang / native
# Moonshot API / DeepSeek API / ByteDance Doubao / etc. Defaults to
# OpenRouter's /api/v1 when unset.
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_API_KEY=dummy

# ── v1.2 paper2any: ingest VLM (PDF structure + caption matching) ─────────

# Used by ingest_document for reading the paper and matching captions to
# pymupdf-extracted figures.
# INGEST_MODEL=gpt-5.4-nano
# INGEST_HTTP_TIMEOUT=600
# INGEST_VLM_MAX_RETRIES=3
# INGEST_VLM_RATE_LIMIT_SLEEP_S=65
# INGEST_VLM_PARALLELISM=1   # useful for low-RPM OpenAI-compatible VLMs

# ── v2.5 image generation (poster backgrounds + landing imagery) ──────────

# Default: `google/gemini-2.5-flash-image` via OpenRouter. Provider
# auto-detects from the model id prefix: `gemini-*` / `imagen-*` →
# native GeminiImageBackend (needs GEMINI_API_KEY); everything else routes to
# OpenRouter.
#
# Switch to Gemini Nano Banana Pro:
#   IMAGE_MODEL=gemini-3-pro-image-preview
#   GEMINI_API_KEY=AIza...
#
# Force a provider when auto-detection guesses wrong (e.g. self-hosted
# mirror that serves a `gemini-*` slug from a non-Google endpoint):
#   IMAGE_PROVIDER=openrouter         # auto | gemini | openrouter | openai_compat
#
# IMAGE_MODEL=google/gemini-2.5-flash-image
# IMAGE_PROVIDER=auto
# IMAGE_FALLBACK_MODEL=openai/gpt-5-image-mini

# ── Coding-agent CLI discovery ───────────────────────────────────────────

# If Codex is installed but `autodesign start` cannot find it, point the
# backend at the executable that works in the same local runtime. This avoids
# relying on a GUI app or a different terminal's PATH.
# AUTODESIGN_CODEX_BIN=/absolute/path/to/codex

# ── Internal authored-poster post-pass refiner ───────────────────────────

# Disabled by default. When enabled, the runner stages final authored poster
# HTML plus paper/identity context under out/runs/<id>/codex_refine/ and invokes
# a local Codex CLI to perform the final hidden poster refinement pass.
# ENABLE_CODEX_REFINER=1
# CODEX_REFINER_CMD=/Applications/Codex.app/Contents/Resources/codex
# CODEX_REFINER_MODEL=
# CODEX_REFINER_TIMEOUT_SECONDS=900
# CODEX_REFINER_MAX_ATTEMPTS=1

# ── Pipeline cache / run telemetry ──────────────────────────────────────────

# Enabled by default. Set the global flag to 0 to force fresh enhancer,
# claim-graph, and PDF-ingest work, or disable only one stage with its specific
# flag.
# AUTODESIGN_PIPELINE_CACHE=1
# AUTODESIGN_PROMPT_ENHANCER_CACHE=1
# AUTODESIGN_CLAIM_GRAPH_CACHE=1
# AUTODESIGN_INGEST_PDF_CACHE=1

# ── OpenResearch GUI submission (optional) ────────────────────────────────

# Enables the Web UI poster-card "OpenResearch" action. AutoDesign stages the
# paper/repo prompt and invokes the configured GUI submitter; OpenResearch owns
# project creation and reproduction execution.
# AUTODESIGN_OPENRESEARCH_ORG_ID=
# AUTODESIGN_OPENRESEARCH_SUBMITTER=custom
# AUTODESIGN_OPENRESEARCH_SUBMITTER_CMD="codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox --cd . --model gpt-5.5 -"
# macOS Codex.app fallback:
# AUTODESIGN_OPENRESEARCH_SUBMITTER_CMD="/Applications/Codex.app/Contents/Resources/codex exec --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox --cd . --model gpt-5.5 -"
# AUTODESIGN_OPENRESEARCH_SUBMITTER_TIMEOUT_SECONDS=900

# Optional starting repository, similar to a Papers with Code repo.
# AUTODESIGN_OPENRESEARCH_REPO=owner/repo

# Optional status/report refresh. `orx login` credentials are also supported.
# AUTODESIGN_OPENRESEARCH_API_URL=https://api.openresearch.sh
# AUTODESIGN_OPENRESEARCH_TOKEN=
# AUTODESIGN_OPENRESEARCH_TIMEOUT_SECONDS=120

# Optional per-million-token prices for run_telemetry_summary.json cost estimates.
# AUTODESIGN_MODEL_PRICES_JSON={"provider/model":{"input_per_million":1.0,"output_per_million":3.0}}
